# =============================================================================
# ETH CALI WALLET - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values
#
# NOTE: Contract addresses live in frontend/, generated by `npm run sync:contracts`
# from ../scs-ethcali — never typed here.
# =============================================================================

# -----------------------------------------------------------------------------
# DEVELOPMENT & DEBUGGING
# -----------------------------------------------------------------------------
# Enable verbose debug logging (set to 'true' for development)
NEXT_PUBLIC_DEBUG=false

# -----------------------------------------------------------------------------
# PRIVY CONFIGURATION (Required)
# Get these from https://dashboard.privy.io
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ prefix is required for client-side access in Next.js
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
# PRIVY_APP_SECRET is server-side only (no NEXT_PUBLIC_ prefix)
PRIVY_APP_SECRET=your_privy_app_secret

# Default chain ID (8453 = Base, 1 = Ethereum, 130 = Unichain, 10 = Optimism)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# Admin wallet address (for swag store management, faucet admin, etc.)
NEXT_PUBLIC_ADMIN_ADDRESS=0x3B89Ad8CC39900778aBCdcc22bc83cAC031A415B

# -----------------------------------------------------------------------------
# RPC ENDPOINTS (Optional)
# For production, use your own Infura/Alchemy/QuickNode keys
# If not set, defaults from config/networks.ts will be used
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# NEXT_PUBLIC_MAINNET_RPC_URL=https://eth.llamarpc.com
# NEXT_PUBLIC_OPTIMISM_RPC_URL=https://mainnet.optimism.io
# NEXT_PUBLIC_UNICHAIN_RPC_URL=https://rpc.unichain.org

# -----------------------------------------------------------------------------
# PINATA (IPFS) CONFIGURATION
# Used for storing NFT metadata and images
# Get your JWT from https://app.pinata.cloud/
# -----------------------------------------------------------------------------
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
PINATASECRET=your_pinata_secret_here
PINATA_APIKEY=your_pinata_api_key_here
# -----------------------------------------------------------------------------
# POAP API (optional)
# Read only by GET /api/poap/holders. Nothing in the swag flow uses it — POAP
# discounts left the contract. Server-side only, never NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
POAP_API_KEY=

# -----------------------------------------------------------------------------
# GAS SPONSORSHIP CONFIGURATION
# Configure gas sponsorship in your Privy Dashboard:
# 1. Go to https://dashboard.privy.io
# 2. Navigate to Gas Sponsorship section
# 3. Enable gas sponsorship for your app
# 4. Add supported networks (Base, Ethereum, Optimism, Unichain)
# 5. Add sponsorship credits to your account balance
# -----------------------------------------------------------------------------

# =============================================================================
# TOKEN ADDRESSES (Optional - defaults provided)
# =============================================================================
# Standard token addresses (USDC, USDT, EURC) can be overridden here
# If not set, defaults from utils/network.ts will be used
# -----------------------------------------------------------------------------
# Base Network
# NEXT_PUBLIC_USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b1566469C5d
# NEXT_PUBLIC_USDT_BASE=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
# NEXT_PUBLIC_EURC_BASE=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
#
# Ethereum Network
# NEXT_PUBLIC_USDC_ETHEREUM=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# NEXT_PUBLIC_USDT_ETHEREUM=0xdAC17F958D2ee523a2206206994597C13D831ec7
# NEXT_PUBLIC_EURC_ETHEREUM=0x1aBaEA1f7C830bD89Acc67eC4af516284b1bC33c
#
# Optimism Network
# NEXT_PUBLIC_USDC_OPTIMISM=0x7F5c764cBc14f9669B88837ca1490cCa17c31607
# NEXT_PUBLIC_USDT_OPTIMISM=0x94b008aA00579c1307B0EF2c499aD98a8ce58e58
#
# Unichain Network
# NEXT_PUBLIC_USDC_UNICHAIN=0x078D782b760474a361dDA0AF3839290b0EF57AD6
# =============================================================================

# =============================================================================
# CONTRACT ADDRESSES
# =============================================================================
# Not configured here. `npm run sync:contracts` copies frontend/ from
# ../scs-ethcali/frontend — addresses.json (SwagFactory, FaucetManager,
# ZKPassportNFT, DonationVault, DonationReceipt1155 per network), the ABIs and
# contracts.ts — and writes frontend/swag-collection.json with the live Swag1155
# clone on Base (ETHCALI-SWAG-2026), which config/constants.ts exposes as
# SWAG_COLLECTION_BASE. Commit the outputs so Vercel builds without the sibling
# checkout. The only address override is SWAG_COLLECTION_ADDRESS, at the bottom.
# =============================================================================

# ============================================================
# DONATIONS
# ============================================================
# Celo — where COPm (Mento Colombian Peso) lives. Public RPC, no key needed.
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# Token overrides (defaults are verified on-chain, override only if they change)
NEXT_PUBLIC_USDC_CELO=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
NEXT_PUBLIC_COPM_CELO=0x8a567e2ae79ca692bd748ab832081c45de4041ea

# ============================================================
# SUPABASE (donation index)
# ============================================================
# The index accelerates the donor wall. The app degrades to reading the
# contract directly when these are absent — it never blocks donations.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# SERVER ONLY. Bypasses RLS — must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bearer token protecting /api/indexer/sync
INDEXER_SECRET=generate_a_long_random_string

# Block to start indexing each chain from (the vault's deployment block).
# Without these the indexer scans from block 0 and will be rate-limited.
INDEXER_START_BLOCK_42220=
INDEXER_START_BLOCK_8453=
INDEXER_START_BLOCK_10=
INDEXER_START_BLOCK_1=
INDEXER_START_BLOCK_130=

# =============================================================================
# SHOPIFY (fiat channel for swag)
# =============================================================================
# The app lives in the Shopify Dev Dashboard (dev.shopify.com), under the
# ETH Cali organisation, and is installed on the store. Dev Dashboard apps have
# no static admin token: the server exchanges client credentials for a 24h
# access token on demand (see scripts/shopify-check.mjs). Server-side only.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Dev Dashboard → your app → Settings → Credentials
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret
# Webhooks the app subscribes to are signed with the client secret. Webhooks
# created under the store's Settings → Notifications use the signing secret
# shown on that page instead. Set whichever you use.
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
# Register this URL in Shopify for orders/paid and refunds/create (JSON,
# API version below). Verified by raw-body HMAC in pages/api/shopify/webhook.ts;
# see docs/SWAG_ORDERS.md for the steps.
#   https://app.ethcali.org/api/shopify/webhook
# Pin it. Shopify deprecates quarterly.
SHOPIFY_API_VERSION=2026-07
# Scripts (all read this file with --env-file=.env, none prints a secret):
#   node --env-file=.env scripts/shopify-check.mjs                # credentials smoke test
#   node --env-file=.env scripts/shopify-sync.mjs --dry-run       # catalogue → DRAFT products, plan only
#   node --env-file=.env scripts/shopify-sync.mjs --prices-only   # TRM re-price by hand
#   node --env-file=.env scripts/shopify-activate.mjs             # DRAFT → ACTIVE + Online Store (one-way)
#   node --env-file=.env scripts/shopify-webhooks.mjs list|create # the app-owned orders/paid + refunds/create subscriptions

# =============================================================================
# CRON (Vercel)
# =============================================================================
# SERVER ONLY. Vercel sends `Authorization: Bearer $CRON_SECRET` with every
# scheduled call; pages/api/cron/swag-prices.ts (daily 12:00 UTC, see
# vercel.json) refuses everything else — and refuses everything when unset.
# Generate a long random string and set it on the Vercel project.
CRON_SECRET=

# =============================================================================
# SWAG CLAIMS (Shopify order → NFT on Base)
# =============================================================================
# SERVER ONLY. Signs EIP-712 claim vouchers (lib/swag/voucher.ts). The address
# derived from this key must hold SIGNER_ROLE on the collection, or every claim
# reverts InvalidSignature. Rotate by granting the new address first, then
# swapping the key. Never NEXT_PUBLIC_, never logged.
#   node --env-file=.env scripts/swag-voucher-selftest.mjs   # prints the address only
SWAG_VOUCHER_SIGNER_KEY=0x_your_32_byte_hex_key
# The Swag1155 collection on Base (8453). Defaults to ETHCALI-SWAG-2026 when
# unset; set it to point a preview deployment at a staging collection.
# SWAG_COLLECTION_ADDRESS=0xA5C02Ee3029Ce7f0FdD147734D11905E3cA99479
